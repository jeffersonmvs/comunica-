# ---------------------------------------------------------------------------
# COMUNICA+ — configuração de ambiente (copie para .env)
# ---------------------------------------------------------------------------

# Porta HTTP/WebSocket do servidor
PORT=3000

# Caminho do banco SQLite (padrão: ./data/comunica.db)
DATABASE_PATH=./data/comunica.db

# Diretório onde os áudios das transmissões são armazenados
# (No produto final: bucket compatível com S3. Aqui: sistema de arquivos.)
AUDIO_DIR=./data/audio

# ---------------------------------------------------------------------------
# Autenticação (JWT). DEFINA um segredo forte em produção.
# ---------------------------------------------------------------------------
JWT_SECRET=comunica-plus-dev-secret-change-me
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Voz ao vivo — SFU (mediasoup). Em localhost os padrões bastam.
# Fora de localhost, defina SFU_ANNOUNCED_IP com o IP público do servidor e
# libere a faixa de portas UDP abaixo no firewall.
# ---------------------------------------------------------------------------
SFU_LISTEN_IP=127.0.0.1
# SFU_ANNOUNCED_IP=
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100

# ---------------------------------------------------------------------------
# Camada de IA — neste MVP os provedores são STUBS determinísticos locais.
# As variáveis abaixo ficam prontas para plugar Whisper/LLM reais depois.
# ---------------------------------------------------------------------------
# AI_TRANSCRIPTION_PROVIDER=stub   # stub | whisper
# AI_SUMMARY_PROVIDER=stub         # stub | llm
# WHISPER_ENDPOINT=
# LLM_API_KEY=
